extends _base.pug
block pageInfo
    -
        var title = 'NICE GROCERY ナイスグロサリー' ;
        var description = 'はじめまして。ナイスグロサリーです。店内で焼き上げたパンやサンドイッチ、全国から揃えたこだわりの食材を販売する食料品店が静岡市にオープンいたします。あなたと私にちょっとしたナイスを。Nice to me to you';
        var ogpimg = 'http://nice-grocery.com/asset/img/ogp.jpg';
        var date = '';
        var url = 'http://nice-grocery.com/';
        var siteName = 'NICE GROCERY ナイスグロサリー';
        var keywords = 'grocery, 静岡, グローサリーストア, shizuoka';

        var imagePath = './asset/img/'
block meta
  . 
    
    <script src="https://unpkg.com/microcms-js-sdk@latest/dist/umd/microcms-js-sdk.js"></script>
  
block body
  main#main
    #header 
      a(href="/") 
        img(src=imagePath+"logo.png", alt="NICE GROCERY", width=1027, height=214)
    #main-visual 
      .images(data-flip-pic=3)
        img(src=imagePath+"mv1.jpg", alt="", width=2636, height=2144).show
        img(src=imagePath+"mv2.jpg", alt="", width=2636, height=2144)
        img(src=imagePath+"mv3.jpg", alt="", width=2636, height=2144)
      .text-area 
        p.address 
          a(href="https://maps.app.goo.gl/6MuZsC2U7jTQUWxL6", target="_blank") 1F 12-9 Temmacho Aoi-ku,<br>Shizuoka-shi, Shizuoka-ken
        p.hour OPEN: 11:00 - 18:00<br>CLOSE: Tuesday / Wednesday

    #main-content 
      section.section.section1#concept.starget-section
        .block
          a.block-head(href="#concept") 
            h2
              span CONCEPT
          .block-inner 
            picture 
              img(src=imagePath+"nicetomeetyou.png", alt="", width=2138, height=1556)
            .concept
              p ナイスをわたしとあなたに。<br>ナイスグロサリーのコンセプトは、<br>Nice to meet youを捩った<br>『Nice to Me, to You』です。<br>自分や相手や地元など、<br>当店を通じていいね！と言い合えたり、<br>感じることができたら<br>ナイスだなという思いから<br>名づけました。<br>肩肘はらず、コンビニライクで<br>気軽に使えるお店を目指しています。<br>あなたのナイスを探しにぜひお越しください。 
      
      section.section.section1-2#about.on
        .block
          a.block-head(href="#about")
            h2
              span ABOUT STORE
          .block-inner.grocery
            img(src=imagePath+"icon-grocery.png", alt="", width=1350, height=900).scroll-in
            .about-inner
              
              h3 ＜GROCERY＞
              p  全国から取り寄せたナイスな調味料。<br>基本的に無添加やオーガニックなどの商品を取り扱っています。
          .block-inner.bread
            img(src=imagePath+"icon-bread.png", alt="", width=1350, height=900).scroll-in
            img(src=imagePath+"icon-dounut.png", alt="", width=1350, height=900).scroll-in
            .about-inner
              
              h3  ＜BREAD＆DONUTS＞
              p  店内で焼き上げたパンやドーナツ。<br>毎日食べても飽きない、ごはんのような存在のパンをご用意しています。<br>ドーナツは卵や乳製品不使用のもっちりとしたドーナツ。朝ごはんや仕事の合間にぴったりです。
          .block-inner.cafe
            img(src=imagePath+"icon-cafe.png", alt="", width=1350, height=900).scroll-in
            .about-inner
              
              h3 ＜CAFE＞
              p 店内にはパンやドーナツ、ドリンクをお買い物の合間にお召し上がりいただけるイートインスペースをご用意しています。<br>曜日限定でカフェメニューもございます。
          .block-inner
            .about-inner
              h3 ⚠️Notes⚠️
              p 曜日ごとの営業時間はInstagramまたはNEWSをご確認ください。<br>※駐車場のご用意はございません。公共交通機関または近隣のコインパーキングをご利用ください。
      .gallery(data-flip-pic=3.4)
        img(src=imagePath+"ph1.jpg", alt="", width=2636, height=2144).show
        img(src=imagePath+"ph2.jpg", alt="", width=2636, height=2144)
        img(src=imagePath+"ph3.jpg", alt="", width=2636, height=2144)
      
      section.section.section2#news.starget-section
        .block
          a.block-head(href="#news") 
            h2
              span news
          .news-target
          a.more(href="/news/") More news &gt;
        
      .gallery(data-flip-pic=3.4).tate
        img(src=imagePath+"ph4.jpg", alt="", width=2636, height=2144).show
        img(src=imagePath+"ph5.jpg", alt="", width=2636, height=2144, style="object-position: center 70%;")
        img(src=imagePath+"ph6.jpg", alt="", width=2636, height=2144)
        img(src=imagePath+"ph7.jpg", alt="", width=2636, height=2144)
      
      section.section.section3#online.starget-section
        .block
          a.block-head(href="#online") 
            h2
              span online store 
          .online-target
            //- .items 
            //-   a.item(href="", target="_blank")
            //-     .img 
            //-       img(src=imagePath+"item1.jpg", alt="", width=1350, height=1688)
            //-     p.item-name オリジナルトートバッグ<br>
            //-       span ¥1,980
            //- .items 
            //-   a.item(href="", target="_blank")
            //-     .img 
            //-       img(src=imagePath+"item1.jpg", alt="", width=1350, height=1688)
            //-     p.item-name オリジナルトートバッグ<br>
            //-       span ¥1,980

      .gallery(data-flip-pic=3.4)
        img(src=imagePath+"ph8.jpg", alt="", width=2636, height=2144).show
        img(src=imagePath+"ph9.jpg", alt="", width=2636, height=2144)
        img(src=imagePath+"ph10.jpg", alt="", width=2636, height=2144)
        img(src=imagePath+"ph11.jpg", alt="", width=2636, height=2144)

      section.section.section4#contact.starget-section
        .block#contact
          a.block-head(href="#contact") 
            h2
              span contact 
          .block-inner 
            a.insta(href="https://www.instagram.com/nice_grocery_/", target="_blank")
              img(src=imagePath+"instagram.png", alt="") 
              span @nice_grocery_
            a.email(href="mailTo:info@nice-grocery.com", target="_blank") 
              img(src=imagePath+"mail.png", alt="") 
              span info@nice-grocery.com
      
      p.copy 2026 &copy; nice grocery

  script. 
    const { createClient } = microcms
    let newsLoaded = false

    const client = createClient({
      serviceDomain: 'nicegrocery',
      apiKey: '256AgCGNEAWRmuJd1LcJblhWI9NcrdRqVAGm',
    })

    const newsTarget = document.querySelector('.news-target')

    client.get({ endpoint: 'news', queries: { limit: 3 }  }).then((res) => {
      const items = res.contents || res
      console.log(res)
      let html = ''

      items.forEach((item, index) => {
        const num = index + 1

        const date = new Date(item.publishedAt)
        const y = date.getFullYear()
        const m = String(date.getMonth() + 1).padStart(2, '0')
        const d = String(date.getDate()).padStart(2, '0')
        const formattedDate = `${y}.${m}.${d}`

        html = `
          <div class="news-block block-inner">
            <div class="news-item ">
              <button class="news-head" data-hide="${num}">
                <div class="date">${formattedDate}</div>
                <h3>${item.title}</h3>
              </button>
              <div class="hide-content" data-hide-target="${num}">
                <div class="news-content">
                  ${item.content}
                </div>
              </div>
            </div>
          </div>
        `
        newsTarget.insertAdjacentHTML('beforebegin', html)
      })

      //- newsLoaded = true
      //- document.dispatchEvent(new CustomEvent('news:loaded'))

    })

    const onlineTarget = document.querySelector('.online-target')

    client.get({ endpoint: 'online-item', queries: { limit: 3 }  }).then((res) => {
      const items = res.contents || res
      console.log(res)
      let html = ''

      items.forEach((item, index) => {
        html = `
          <div class="items">
            <a class="item" href="${item.link}" target="_blank">
              <div class="img">
                <img src="${item.image.url}" alt="${item.itemname}" width="1350" height="1688">
              </div>
              <p class="item-name">${item.itemname}<br><span>${item.price}</span></p>
            </a>
          </div>
        `
        onlineTarget.insertAdjacentHTML('beforebegin', html)
      })

      newsLoaded = true
      document.dispatchEvent(new CustomEvent('news:loaded'))

    })
  
  script(src='asset/js/script.js')